# Copy this file to .env and fill in your key. .env is gitignored — never commit it.
#
# Get a key at https://aistudio.google.com -> Get API key.
# Billing MUST be enabled on the project: the Live API is not on the free tier,
# and without billing every realtime connection is refused even though the key
# looks valid.
GEMINI_API_KEY=

# --- optional, sensible defaults are in src/server.js ---

# PORT=8787
# MODEL=gemini-3.1-flash-live-preview

# How long one conversation may run before the token expires.
# SESSION_MINUTES=10

# Sessions per device per day. 0 = unlimited, which is the default so that
# development is not annoying. For the ~15 min/day product decision, pair
# SESSION_MINUTES=5 with SESSIONS_PER_DAY=3 before anyone else has the app.
# SESSIONS_PER_DAY=0

# Shared secret the app must send as the x-ordi-key header.
# Leave empty for local development. MUST be set once this is reachable from
# the internet, or anyone with the URL can mint tokens against your key.
# Generate one with:  openssl rand -hex 32
# ORDI_CLIENT_SECRET=

# Which voice Ordi speaks with. Without this the model picks one per session
# and Ordi sounds like a different person every time.
# Male-sounding: Charon, Orus, Puck, Iapetus, Achird, Gacrux
# Female-sounding: Kore, Zephyr, Aoede, Leda, Sulafat
# VOICE=Charon
